+# Phase A IRQ spike lane. It is a bounded observation of interrupt delivery and
+# is deliberately excluded from `check`, `test`, and every verification path:
+# a spike result is not a checkpoint and must not enter the evidence bundle.
+irq_spike_artifact_dir="$root/artifacts/irq-spike"
+
+check_irq_spike_kernel() {
+    container cargo fmt --all -- --check
+    container env CARGO_TARGET_DIR=/work/target/irq-spike-check \
+        cargo clippy --locked --target x86_64-unknown-none --lib \
+        --features irq-spike -- \
+        -D warnings \
+        -A unexpected_cfgs \
+        -A clippy::result_large_err
+}
+
+build_irq_spike_kernel() {
+    check_source
+    check_irq_spike_kernel
+    prepare_runner_base
+    container cargo osdk build --scheme irq-spike
+    # `assert_runner_base` is deliberately NOT run for this lane. Selecting a
+    # Cargo feature makes OSDK 0.18 propagate it into the generated run-base
+    # manifest (`irq-spike = ["ostd-virtio-cser-spike/irq-spike"]`), which
+    # forces OSDK to regenerate the whole run-base directory from its embedded
+    # templates. Those templates indent otherwise-blank linker-script lines,
+    # while the repository's pinned `osdk-runner-base/*.ld` do not, so the
+    # byte-exact comparison can never hold for a feature-selecting lane. The
+    # difference is whitespace in the OSDK runner shim's linker scripts; it does
+    # not touch the pinned OSTD/VirtIO patch inputs that the kernel is built
+    # from. Restore the pinned base afterwards so the Stage 5B lane, which does
+    # assert it, is never handed regenerated state.
+    prepare_runner_base
+}
+
+run_irq_spike_kernel() {
+    build_irq_spike_kernel
+    container bash -c '
+        set -u
+        cp /root/ovmf/release/OVMF_VARS.fd "$HOME/OVMF_VARS.fd"
+        expected=27a4e8fed7b428b42ff04e3f62eadfe2e3f3310dac4e2fe8ecfff04be3cca254
+        before=$(sha256sum /opt/nexus-fixtures/sector0.raw | cut -d " " -f1)
+        set +e
+        timeout --signal=TERM --kill-after=2s 60s \
+            cargo osdk run --scheme irq-spike
+        status=$?
+        set -e
+        after=$(sha256sum /opt/nexus-fixtures/sector0.raw | cut -d " " -f1)
+        echo "FIXTURE Hash before=$before after=$after readonly=true"
+        test "$before" = "$expected"
+        test "$after" = "$expected"
+        exit "$status"
+    '
+    # `cargo osdk run` regenerates the run-base for the same reason the build
+    # does, so this lane restores the pinned base rather than asserting it. See
+    # the note in `build_irq_spike_kernel`.
+    prepare_runner_base
+}
+
+extract_irq_spike_suffix() {
+    local source=$1
+    local target=$2
+    awk '
+        /IRQ_SPIKE KERNEL_MARKER stage=phase_a oracle_suffix=true/ { found = 1 }
+        found { gsub(/\r/, ""); print }
+        END { if (!found) exit 1 }
+    ' "$source" > "$target"
+}
+
+capture_irq_spike_run() {
+    capture_qemu_streams \
+        "$irq_spike_artifact_dir/serial.log" \
+        "$irq_spike_artifact_dir/qemu-debug.log" \
+        run_irq_spike_kernel
+    echo 'QEMU_CAPTURE PASS profile=irq-spike live_replay=false serial=artifacts/irq-spike/serial.log debug=artifacts/irq-spike/qemu-debug.log'
+}
+
 check_stream_capture() {
     bash "$root/scripts/assert-stream-capture.sh"
 }
