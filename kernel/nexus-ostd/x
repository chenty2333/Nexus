hash_core_persistent_tree() {
    local directory=$1
    if find "$directory" -type l -print -quit | grep -q .; then
        echo "persistent evidence tree contains a symlink: $directory" >&2
        return 1
    fi
    (
        cd "$directory"
        local relative digest
        while IFS= read -r -d '' relative; do
            digest=$(sha256sum -- "$relative" | cut -d ' ' -f1)
            printf '%s\0%s\0' "$relative" "$digest"
        done < <(find . -type f -printf '%P\0' | LC_ALL=C sort -z)
    ) | sha256sum | cut -d ' ' -f1
}

