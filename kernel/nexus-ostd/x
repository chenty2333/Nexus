require_core_persistent_marker() {
    local serial=$1
    local marker=$2
    shift 2
    local line field
    if ! line=$(tr -d '\r' <"$serial" | grep -F "$marker" | tail -n 1); then
        echo "missing persistent recovery marker '$marker' in $serial" >&2
        return 1
    fi
    for field in "$@"; do
        if [[ " $line " != *" $field "* ]]; then
            echo "persistent recovery marker '$marker' lacks '$field'" >&2
            return 1
        fi
    done
}

core_persistent_marker_u64() {
    local line=$1
    local field=$2
    local token value= count=0
    for token in $line; do
        if [[ $token == "$field="* ]]; then
            value=${token#*=}
            ((count += 1))
        fi
    done
    if (( count != 1 )) || [[ ! $value =~ ^[1-9][0-9]*$ ]]; then
        echo "persistent recovery marker has an invalid $field coordinate: $line" >&2
        return 1
    fi
    printf '%s\n' "$value"
}

assert_core_persistent_freshness_progression() {
    local -a markers=("$@")
    local -a revisions=() boots=() journals=() devices=()
    local marker index previous coordinate
    for marker in "${markers[@]}"; do
        coordinate=$(core_persistent_marker_u64 "$marker" revision) || return 1
        revisions+=("$coordinate")
        coordinate=$(core_persistent_marker_u64 "$marker" boot) || return 1
        boots+=("$coordinate")
        coordinate=$(core_persistent_marker_u64 "$marker" journal) || return 1
        journals+=("$coordinate")
        coordinate=$(core_persistent_marker_u64 "$marker" device) || return 1
        devices+=("$coordinate")
    done
    if (( ${#markers[@]} != 4 )); then
        echo "persistent freshness progression requires exactly four markers" >&2
        return 1
    fi
    for index in 1 2 3; do
        previous=$((index - 1))
        if (( 10#${revisions[$index]} <= 10#${revisions[$previous]} )) \
            || (( 10#${boots[$index]} <= 10#${boots[$previous]} )) \
            || (( 10#${journals[$index]} <= 10#${journals[$previous]} )) \
            || (( 10#${devices[$index]} <= 10#${devices[$previous]} )); then
            echo "persistent recovery freshness did not strictly increase at boot $((index + 1))" >&2
            return 1
        fi
    done
    printf 'revision=%s boot=%s journal=%s device=%s\n' \
        "$(IFS=,; echo "${revisions[*]}")" \
        "$(IFS=,; echo "${boots[*]}")" \
        "$(IFS=,; echo "${journals[*]}")" \
        "$(IFS=,; echo "${devices[*]}")"
}

assert_core_persistent_service_identity_progression() {
    local -a markers=("$@")
    local -a principals=() bindings=()
    local marker index expected coordinate
    if (( ${#markers[@]} != 4 )); then
        echo "persistent service identity progression requires exactly four markers" >&2
        return 1
    fi
    for marker in "${markers[@]}"; do
        coordinate=$(core_persistent_marker_u64 \
            "$marker" service_principal_generation) || return 1
        principals+=("$coordinate")
        coordinate=$(core_persistent_marker_u64 \
            "$marker" binding_generation) || return 1
        bindings+=("$coordinate")
    done
    for index in 0 1 2 3; do
        expected=$((index + 1))
        if (( 10#${principals[$index]} != expected )) \
            || (( 10#${bindings[$index]} != expected )); then
            echo "persistent service identity is not the exact fresh boot $expected pair" >&2
            return 1
        fi
    done
    printf 'service_principal_generation=%s binding_generation=%s\n' \
        "$(IFS=,; echo "${principals[*]}")" \
        "$(IFS=,; echo "${bindings[*]}")"
}

core_persistent_qemu_event_count() {
    local debug_log=$1
    local event_prefix=$2
    awk -v prefix="$event_prefix" '
        index($0, prefix) == 1 { count += 1 }
        END { print count + 0 }
    ' "$debug_log"
}

hash_core_persistent_tree() {
    local directory=$1
    if find "$directory" -type l -print -quit | grep -q .; then
        echo "persistent evidence tree contains a symlink: $directory" >&2
        return 1
    fi
    (
        cd "$directory"
        local relative digest
        while IFS= read -r -d '' relative; do
            digest=$(sha256sum -- "$relative" | cut -d ' ' -f1)
            printf '%s\0%s\0' "$relative" "$digest"
        done < <(find . -type f -printf '%P\0' | LC_ALL=C sort -z)
    ) | sha256sum | cut -d ' ' -f1
}

