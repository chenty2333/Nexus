    local marker index expected coordinate
    if (( ${#markers[@]} != 4 )); then
        echo "persistent service identity progression requires exactly four markers" >&2
        return 1
    fi
    for marker in "${markers[@]}"; do
        coordinate=$(core_persistent_marker_u64 \
            "$marker" service_principal_generation) || return 1
        principals+=("$coordinate")
        coordinate=$(core_persistent_marker_u64 \
