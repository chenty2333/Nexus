require_core_persistent_marker() {
    local serial=$1
    local marker=$2
    shift 2
    local line field
    if ! line=$(tr -d '\r' <"$serial" | grep -F "$marker" | tail -n 1); then
        echo "missing persistent recovery marker '$marker' in $serial" >&2
        return 1
    fi
    for field in "$@"; do
        if [[ " $line " != *" $field "* ]]; then
            echo "persistent recovery marker '$marker' lacks '$field'" >&2
            return 1
        fi
    done
}

core_persistent_marker_u64() {
    local line=$1
    local field=$2
    local token value= count=0
    for token in $line; do
        if [[ $token == "$field="* ]]; then
            value=${token#*=}
            ((count += 1))
        fi
    done
    if (( count != 1 )) || [[ ! $value =~ ^[1-9][0-9]*$ ]]; then
        echo "persistent recovery marker has an invalid $field coordinate: $line" >&2
        return 1
    fi
    printf '%s\n' "$value"
}

core_persistent_marker_digest() {
    local line=$1
    local field=$2
    local token value= count=0
    for token in $line; do
        if [[ $token == "$field="* ]]; then
            value=${token#*=}
            ((count += 1))
        fi
    done
    if (( count != 1 )) || [[ ! $value =~ ^[0-9a-f]{64}$ ]]; then
        echo "persistent recovery marker has an invalid $field digest: $line" >&2
        return 1
    fi
    printf '%s\n' "$value"
}

assert_core_persistent_semantic_coordinates() {
    local expected_catalog=$1
    shift
    local -a markers=("$@") projections=()
    local marker observed_catalog projection arena_boot1 arena_boot3
    local -A distinct_projections=()
    if (( ${#markers[@]} != 4 )); then
        echo 'persistent semantic-coordinate proof requires exactly four markers' >&2
        return 1
    fi
    for marker in "${markers[@]}"; do
        observed_catalog=$(core_persistent_marker_digest \
            "$marker" catalog_digest) || return 1
        if [[ $observed_catalog != "$expected_catalog" ]]; then
            echo 'guest catalog digest differs from the pinned host catalog digest' >&2
            return 1
        fi
        projection=$(core_persistent_marker_digest \
            "$marker" projection_digest) || return 1
        projections+=("$projection")
        distinct_projections["$projection"]=1
    done
    if (( ${#distinct_projections[@]} != 4 )); then
        echo 'persistent recovery did not expose four distinct boot projections' >&2
        return 1
    fi
    arena_boot1=$(core_persistent_marker_digest \
        "${markers[0]}" arena_contract_digest) || return 1
    arena_boot3=$(core_persistent_marker_digest \
        "${markers[2]}" arena_contract_digest) || return 1
    if [[ $arena_boot1 != "$arena_boot3" ]]; then
        echo 'persistent DMA arena provider contract changed across generation reuse' >&2
        return 1
    fi
    printf 'catalog_digest=%s projection_digests=%s arena_contract_digest=%s\n' \
        "$expected_catalog" \
        "$(IFS=,; echo "${projections[*]}")" \
        "$arena_boot1"
}

core_persistent_marker_bounded_decimal() {
    local line=$1
    local field=$2
    local maximum=$3
    local LC_ALL=C
    local token value= count=0
    for token in $line; do
        if [[ $token == "$field="* ]]; then
            value=${token#*=}
            ((count += 1))
        fi
    done
    if (( count != 1 )) || [[ ! $value =~ ^[1-9][0-9]*$ ]]; then
        echo "persistent recovery marker has an invalid $field decimal: $line" >&2
        return 1
    fi
    if (( ${#value} > ${#maximum} )) \
        || { (( ${#value} == ${#maximum} )) && [[ $value > $maximum ]]; }; then
        echo "persistent recovery marker exceeds the $field bound $maximum: $line" >&2
        return 1
    fi
    printf '%s\n' "$value"
}

core_persistent_trace_has_exact_dma_mapping() {
    local trace=$1
    local iova=$2
    local expected=$3
    awk -v target_iova="$iova" -v expected="$expected" '
        $1 == "vtd_dmar_translate" \
            && $2 == "dev" \
            && $3 == "00:05.00" \
            && $4 == "iova" \
            && $5 == target_iova {
                seen += 1
                if ($0 != expected) {
                    conflicting += 1
                }
            }
        END {
            exit !(seen > 0 && conflicting == 0)
        }
    ' "$trace"
}

assert_core_persistent_dma_arena_reuse() {
    local boot1_marker=$1
    local boot3_marker=$2
    local boot1_trace=$3
    local boot3_trace=$4
    local boot1_generation boot3_generation
    local boot1_guest boot1_iova boot1_offset
    local boot3_guest boot3_iova boot3_offset
    local page_size=4096 arena_pages=3 ram_size=1073741824
    local max_offset max_guest_pfn
    local max_iova=9223372036854767615
    max_offset=$((ram_size - arena_pages * page_size))
    max_guest_pfn=$((max_offset / page_size))
    boot1_generation=$(core_persistent_marker_u64 \
        "$boot1_marker" resource_generation) || return 1
    boot3_generation=$(core_persistent_marker_u64 \
        "$boot3_marker" resource_generation) || return 1
    if [[ $boot1_generation != 1 || $boot3_generation != 2 ]]; then
        echo 'persistent DMA arena did not advance from generation 1 to 2' >&2
        return 1
    fi
    boot1_guest=$(core_persistent_marker_bounded_decimal \
        "$boot1_marker" guest_pfn_base "$max_guest_pfn") || return 1
    boot1_iova=$(core_persistent_marker_bounded_decimal \
        "$boot1_marker" emulated_iova_base "$max_iova") || return 1
    boot1_offset=$(core_persistent_marker_bounded_decimal \
        "$boot1_marker" host_backing_offset "$max_offset") || return 1
    boot3_guest=$(core_persistent_marker_bounded_decimal \
        "$boot3_marker" guest_pfn_base "$max_guest_pfn") || return 1
    boot3_iova=$(core_persistent_marker_bounded_decimal \
        "$boot3_marker" emulated_iova_base "$max_iova") || return 1
    boot3_offset=$(core_persistent_marker_bounded_decimal \
        "$boot3_marker" host_backing_offset "$max_offset") || return 1
    if [[ $boot1_guest != "$boot3_guest" \
        || $boot1_iova != "$boot3_iova" \
        || $boot1_offset != "$boot3_offset" ]]; then
        echo 'persistent DMA arena coordinates changed between generations' >&2
        return 1
    fi
    if (( boot1_offset / page_size != boot1_guest \
        || boot3_offset / page_size != boot3_guest \
        || boot1_iova % page_size != 0 \
        || boot1_offset % page_size != 0 \
        || boot1_offset > ram_size - arena_pages * page_size )); then
        echo 'persistent DMA arena coordinates do not identify an aligned PFN-backed range' >&2
        return 1
    fi
    local trace page iova gpa iova_token mapping
    for trace in "$boot1_trace" "$boot3_trace"; do
        for page in 0 1 2; do
            iova=$((boot1_iova + page * page_size))
            gpa=$((boot1_offset + page * page_size))
            printf -v iova_token '0x%x' "$iova"
            printf -v mapping \
                'vtd_dmar_translate dev 00:05.00 iova 0x%x -> gpa 0x%x mask 0xfff' \
                "$iova" "$gpa"
            if ! core_persistent_trace_has_exact_dma_mapping \
                "$trace" "$iova_token" "$mapping"; then
                echo "persistent DMA arena has a missing or conflicting VT-d mapping '$mapping' in $trace" >&2
                return 1
            fi
        done
    done
    printf 'resource_generation=1->2 guest_pfn_base=%s emulated_iova_base=%s host_backing_offset=%s\n' \
        "$boot1_guest" "$boot1_iova" "$boot1_offset"
}

selftest_core_persistent_dma_arena_reuse() (
    local tmp valid_trace conflicting_trace wide_mask_trace
    local boot1_marker boot3_marker
    local overflow_boot1 overflow_boot3 generation_boot1 generation_boot3
    tmp=$(mktemp -d)
    trap 'rm -rf -- "$tmp"' EXIT
    valid_trace="$tmp/valid.trace"
    conflicting_trace="$tmp/conflicting-gpa.trace"
    wide_mask_trace="$tmp/wide-mask.trace"
    boot1_marker='CSER_CORE_PERSISTENT_BOOT1 PASS resource_generation=1 guest_pfn_base=196608 emulated_iova_base=1073741824 host_backing_offset=805306368'
    boot3_marker='CSER_CORE_PERSISTENT_BOOT3 PASS resource_generation=2 prior_resource_generation=1 guest_pfn_base=196608 emulated_iova_base=1073741824 host_backing_offset=805306368'
    printf '%s\n' \
        'vtd_dmar_translate dev 00:05.00 iova 0x40000000 -> gpa 0x30000000 mask 0xfff' \
        'vtd_dmar_translate dev 00:05.00 iova 0x40001000 -> gpa 0x30001000 mask 0xfff' \
        'vtd_dmar_translate dev 00:05.00 iova 0x40002000 -> gpa 0x30002000 mask 0xfff' \
        >"$valid_trace"
    if ! assert_core_persistent_dma_arena_reuse \
        "$boot1_marker" "$boot3_marker" "$valid_trace" "$valid_trace" \
        >/dev/null 2>&1; then
        echo 'persistent DMA arena checker self-test rejected its positive fixture' >&2
        return 1
    fi

    cp "$valid_trace" "$conflicting_trace"
    printf '%s\n' \
        'vtd_dmar_translate dev 00:05.00 iova 0x40000000 -> gpa 0x30001000 mask 0xfff' \
        >>"$conflicting_trace"
    if assert_core_persistent_dma_arena_reuse \
        "$boot1_marker" "$boot3_marker" "$conflicting_trace" "$valid_trace" \
        >/dev/null 2>&1; then
        echo 'persistent DMA arena checker accepted a conflicting GPA' >&2
        return 1
    fi

    sed '0,/mask 0xfff/s//mask 0xffff/' "$valid_trace" >"$wide_mask_trace"
    if assert_core_persistent_dma_arena_reuse \
        "$boot1_marker" "$boot3_marker" "$wide_mask_trace" "$valid_trace" \
        >/dev/null 2>&1; then
        echo 'persistent DMA arena checker accepted mask 0xffff' >&2
        return 1
    fi

    overflow_boot1=${boot1_marker/guest_pfn_base=196608/guest_pfn_base=4503599627567104}
    overflow_boot3=${boot3_marker/guest_pfn_base=196608/guest_pfn_base=4503599627567104}
    if assert_core_persistent_dma_arena_reuse \
        "$overflow_boot1" "$overflow_boot3" "$valid_trace" "$valid_trace" \
        >/dev/null 2>&1; then
        echo 'persistent DMA arena checker accepted a wrapping PFN' >&2
        return 1
    fi

    generation_boot1=${boot1_marker/resource_generation=1/resource_generation=18446744073709551617}
    generation_boot3=${boot3_marker/resource_generation=2/resource_generation=18446744073709551618}
    if assert_core_persistent_dma_arena_reuse \
        "$generation_boot1" "$generation_boot3" "$valid_trace" "$valid_trace" \
        >/dev/null 2>&1; then
        echo 'persistent DMA arena checker accepted wrapping generations' >&2
        return 1
    fi

    echo 'persistent DMA arena checker self-test: PASS positive=accepted conflicting_gpa=rejected mask_0xffff=rejected pfn_overflow=rejected generation_overflow=rejected'
)

assert_core_persistent_freshness_progression() {
    local -a markers=("$@")
    local -a revisions=() boots=() journals=() devices=()
    local marker index previous coordinate
    for marker in "${markers[@]}"; do
        coordinate=$(core_persistent_marker_u64 "$marker" revision) || return 1
        revisions+=("$coordinate")
        coordinate=$(core_persistent_marker_u64 "$marker" boot) || return 1
        boots+=("$coordinate")
        coordinate=$(core_persistent_marker_u64 "$marker" journal) || return 1
        journals+=("$coordinate")
        coordinate=$(core_persistent_marker_u64 "$marker" device) || return 1
        devices+=("$coordinate")
    done
    if (( ${#markers[@]} != 4 )); then
        echo "persistent freshness progression requires exactly four markers" >&2
        return 1
    fi
    for index in 1 2 3; do
        previous=$((index - 1))
        if (( 10#${revisions[$index]} <= 10#${revisions[$previous]} )) \
            || (( 10#${boots[$index]} <= 10#${boots[$previous]} )) \
            || (( 10#${journals[$index]} <= 10#${journals[$previous]} )) \
            || (( 10#${devices[$index]} <= 10#${devices[$previous]} )); then
            echo "persistent recovery freshness did not strictly increase at boot $((index + 1))" >&2
            return 1
        fi
    done
    printf 'revision=%s boot=%s journal=%s device=%s\n' \
        "$(IFS=,; echo "${revisions[*]}")" \
        "$(IFS=,; echo "${boots[*]}")" \
        "$(IFS=,; echo "${journals[*]}")" \
        "$(IFS=,; echo "${devices[*]}")"
}

assert_core_persistent_service_identity_progression() {
    local -a markers=("$@")
