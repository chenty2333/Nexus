            "$((boot2_dma_translation_count + boot3_dma_translation_count + boot4_dma_translation_count))"
        printf 'boot1_serial_sha256=%s\n' "$(sha256sum \
            "$core_persistent_artifact_dir/boot1-serial.log" | cut -d ' ' -f1)"
        printf 'boot1_qemu_debug_sha256=%s\n' "$(sha256sum \
            "$core_persistent_artifact_dir/boot1-qemu-debug.log" \
            | cut -d ' ' -f1)"
        printf 'boot2_serial_sha256=%s\n' "$(sha256sum \
            "$core_persistent_artifact_dir/boot2-serial.log" | cut -d ' ' -f1)"
        printf 'boot2_qemu_debug_sha256=%s\n' "$(sha256sum \
            "$core_persistent_artifact_dir/boot2-qemu-debug.log" \
            | cut -d ' ' -f1)"
        printf 'boot3_serial_sha256=%s\n' "$(sha256sum \
            "$core_persistent_artifact_dir/boot3-serial.log" | cut -d ' ' -f1)"
        printf 'boot3_qemu_debug_sha256=%s\n' "$(sha256sum \
            "$core_persistent_artifact_dir/boot3-qemu-debug.log" \
            | cut -d ' ' -f1)"
        printf 'boot4_serial_sha256=%s\n' "$(sha256sum \
            "$core_persistent_artifact_dir/boot4-serial.log" | cut -d ' ' -f1)"
        printf 'boot4_qemu_debug_sha256=%s\n' "$(sha256sum \
            "$core_persistent_artifact_dir/boot4-qemu-debug.log" \
            | cut -d ' ' -f1)"
        printf 'journal_sha256=%s\n' "$(sha256sum \
            "$core_persistent_journal" | cut -d ' ' -f1)"
        printf 'outbox_sha256=%s\n' "$(sha256sum \
            "$core_persistent_outbox" | cut -d ' ' -f1)"
        printf 'ram_backing_sha256=%s\n' "$(sha256sum \
            "$core_persistent_ram" | cut -d ' ' -f1)"
        printf 'tpm_state_sha256=%s\n' "$tpm_state_sha256"
    } >"$core_persistent_artifact_dir/$receipt_basename"
    receipt_sha256=$(sha256sum \
        "$core_persistent_artifact_dir/$receipt_basename" | cut -d ' ' -f1)
    printf '%s  %s\n' "$receipt_sha256" "$receipt_basename" \
        >"$core_persistent_artifact_dir/$receipt_checksum_basename"
    printf '%s git_revision=%s git_source_tree_clean=%s receipt_sha256=%s\n' \
        "$combined_receipt" "$git_revision" "$source_tree_clean" "$receipt_sha256"
    if [[ $seal_failure == true ]]; then
        echo 'CSER production receipt seal rejected: source tree changed during proof' >&2
        return 1
    fi
}


run_production_recovery() {
    prepare_core_persistent_artifacts
    bash "$root/scripts/assert-cser-core-production-cutover.sh" "$repo_root"
    capture_core_reply_evidence
    capture_core_dma_evidence
    capture_core_persistent_run
}

