# One boot of a host-owned CSER experiment envelope.  The matching
# matrix controller stages unique media before invoking this command and kills
# its process group at the authenticated COM3 target barrier.  This helper
# deliberately has no success oracle: recovery acceptance belongs to the
# guest's serial terminal receipt, parsed by tools/cser-experiment.
tool_dma_swtpm_pid=
start_tool_dma_swtpm() {
    local artifact_dir=$1 socket pid_file capabilities flags observed_pid
    artifact_dir=$(realpath -e -- "$artifact_dir")
    socket="$artifact_dir/swtpm-qemu.sock"
    pid_file="$artifact_dir/swtpm.pid"
    command -v swtpm >/dev/null 2>&1 || {
        echo 'tool-DMA QEMU boot requires host swtpm' >&2
        return 1
    }
    capabilities=$(swtpm socket --print-capabilities) || return 1
    flags=not-need-init,startup-none
    if grep -Fq '"flags-opt-disable-auto-shutdown"' <<<"$capabilities"; then
        flags+=,disable-auto-shutdown
    fi
    rm -f -- "$socket" "$pid_file"
    mkdir -p "$artifact_dir/tpmstate"
    swtpm socket --tpm2 --tpmstate "dir=$artifact_dir/tpmstate" \
        --ctrl "type=unixio,path=$socket" --flags "$flags" \
        --log "file=$artifact_dir/swtpm.log,level=20" --pid "file=$pid_file" &
    tool_dma_swtpm_pid=$!
    for _ in {1..500}; do
        observed_pid=
        [[ -f $pid_file ]] && observed_pid=$(tr -d '\n' <"$pid_file")
        if [[ $observed_pid == "$tool_dma_swtpm_pid" && -S $socket ]] \
            && kill -0 "$tool_dma_swtpm_pid" 2>/dev/null; then
            return 0
        fi
        kill -0 "$tool_dma_swtpm_pid" 2>/dev/null || break
        sleep .01
    done
    echo 'tool-DMA swtpm did not become ready' >&2
    stop_tool_dma_swtpm
    return 1
}

stop_tool_dma_swtpm() {
    local pid=${tool_dma_swtpm_pid:-}
    [[ -n $pid ]] || return 0
    if kill -0 "$pid" 2>/dev/null; then
        kill -KILL "$pid" 2>/dev/null || true
        wait "$pid" 2>/dev/null || true
    fi
    tool_dma_swtpm_pid=
}

run_tool_dma_boot() (
    local scheme=$1 artifact_dir status=0 launcher_timeout_seconds=90
    local record_cid=0
    case "$scheme" in
        tool-dma-cser) artifact_dir="$root/artifacts/tool-dma-cser" ;;
        tool-dma-cser-vnext) artifact_dir="$root/artifacts/tool-dma-cser-vnext" ;;
        tool-dma-baseline) artifact_dir="$root/artifacts/tool-dma-baseline" ;;
        tool-handoff-cser) artifact_dir="$root/artifacts/tool-handoff-cser" ;;
        tool-handoff-baseline) artifact_dir="$root/artifacts/tool-handoff-baseline" ;;
        *) echo "invalid CSER experiment scheme: $scheme" >&2; return 2 ;;
    esac
    for medium in journal.raw outbox.raw ram.raw; do
        [[ -f $artifact_dir/$medium ]] || {
            echo "tool-DMA boot requires staged medium: $artifact_dir/$medium" >&2
            return 2
        }
    done
    # Handoff recovery has two endpoint reconciliations plus a stable reopen.
    # Keep this narrow exception out of the initial crash envelope and every
    # existing Tool+DMA scheme, whose reviewed inner timeout remains 90s.
    if [[ ${CSER_EXPERIMENT_PHASE:-initial} == recovery \
        && ( $scheme == tool-handoff-cser || $scheme == tool-handoff-baseline ) ]]; then
        launcher_timeout_seconds=130
    fi
    trap 'stop_tool_dma_swtpm' EXIT INT TERM
    start_tool_dma_swtpm "$artifact_dir"
    if [[ ${CSER_EXPERIMENT_PHASE:-initial} == initial \
        && -n ${CSER_EXPERIMENT_CID_FILE:-} ]]; then
        record_cid=1
    fi
    NEXUS_CONTAINER_HOST_UNIX_SOCKET=1 NEXUS_CONTAINER_RECORD_CID=$record_cid container bash -c "
        set -euo pipefail
        cp /root/ovmf/release/OVMF_VARS.fd \"\$HOME/OVMF_VARS.fd\"
