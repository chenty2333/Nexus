start_core_persistent_swtpm() {
    local capabilities flags observed_pid
    if ! command -v swtpm >/dev/null 2>&1; then
        echo "run-core-persistent-recovery requires host swtpm" >&2
        return 1
    fi
    if ! capabilities=$(swtpm socket --print-capabilities); then
        echo "failed to query host swtpm capabilities" >&2
        return 1
    fi
    flags=not-need-init,startup-none
    # swtpm added automatic TPM2_Shutdown and its opt-out together in v0.8.
    # Older releases have neither behavior, so capability negotiation preserves
    # the same crash-style stop on both sides of that version boundary.
    if grep -Fq '"flags-opt-disable-auto-shutdown"' <<<"$capabilities"; then
        flags+=,disable-auto-shutdown
    fi
    rm -f "$core_persistent_socket" "$core_persistent_pid_file"
    # The runner-wide repo/kernel flocks and sequential boot loop give this
    # daemon exclusive custody of the state directory. Do not require the
    # optional swtpm backend `lock` flag, which Ubuntu 24.04's swtpm 0.7.3
    # does not implement.
    swtpm socket \
        --tpm2 \
        --tpmstate "dir=$core_persistent_state_dir" \
        --ctrl "type=unixio,path=$core_persistent_socket" \
        --flags "$flags" \
        --log "file=$core_persistent_artifact_dir/swtpm.log,level=20" \
        --pid "file=$core_persistent_pid_file" &
    core_persistent_pid=$!
    for _ in {1..500}; do
        observed_pid=
        if [[ -f $core_persistent_pid_file ]]; then
            observed_pid=$(tr -d '\n' <"$core_persistent_pid_file")
        fi
        if [[ $observed_pid == "$core_persistent_pid" ]] \
            && [[ -S $core_persistent_socket ]] \
            && kill -0 "$core_persistent_pid" 2>/dev/null; then
            return 0
        fi
        if ! kill -0 "$core_persistent_pid" 2>/dev/null; then
            break
        fi
        sleep 0.01
    done
    echo "swtpm did not create the persistent-profile socket" >&2
    stop_core_persistent_swtpm
    return 1
}

stop_core_persistent_swtpm() {
    local pid=${core_persistent_pid:-}
    if [[ -z $pid ]]; then
        return 0
    fi
    if [[ ! $pid =~ ^[1-9][0-9]*$ ]]; then
        echo "swtpm returned an invalid persistent-profile pid: $pid" >&2
        return 1
    fi
    if kill -0 "$pid" 2>/dev/null; then
        if ! kill -KILL "$pid" 2>/dev/null && kill -0 "$pid" 2>/dev/null; then
            echo "failed to send SIGKILL to persistent-profile swtpm: pid=$pid" >&2
            return 1
        fi
        for _ in {1..500}; do
            if ! kill -0 "$pid" 2>/dev/null; then
                core_persistent_pid=
                return 0
            fi
            sleep 0.01
        done
        echo "persistent-profile swtpm did not exit after SIGKILL: pid=$pid" >&2
        return 1
    fi
    core_persistent_pid=
}

