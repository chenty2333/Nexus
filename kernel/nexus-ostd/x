        "$root/scripts/qemu-stream-capture.sh" \
        "$root/scripts/build-runtime-fs.sh" \
        "$root/scripts/build-runtime-fs-block-image.sh" \
        "$root/scripts/assert-runtime-fs-block-image.sh" \
        "$root/scripts/provision-cser-tpm-nv.sh" \
        "$repo_root/tests/guest/linux/sources/linux-runtime-fs-smoke/runtime_fs_smoke.S" \
