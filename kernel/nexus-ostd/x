build_core_schema5_selected_fixture() (
    set -euo pipefail
    local source_dir source_relative source_archive source_archive_sha
    local logical_relative origin_output legacy_catalog logical_len logical_sha
    local payload_sha logical_len_hex header_prefix_hex header_sha header_file
    local pio_sha final_head
    source_dir=$(mktemp -d "$core_persistent_artifact_dir/schema5-source.XXXXXX")
    trap 'rm -rf -- "$source_dir"' EXIT
    source_relative=${source_dir#"$root"/}
    if [[ $source_relative == "$source_dir" || $source_relative == /* ]]; then
        echo 'schema-5 source fixture escaped the mounted artifact directory' >&2
        return 1
    fi
    source_archive="$source_dir/source.tar"
    git -C "$repo_root" cat-file -e "$core_schema5_fixture_revision^{commit}"
    git -C "$repo_root" archive --format=tar \
        "$core_schema5_fixture_revision" >"$source_archive"
    source_archive_sha=$(sha256sum "$source_archive" | cut -d ' ' -f1)
    tar -xf "$source_archive" -C "$source_dir"
    rm -f -- "$source_archive"

    logical_relative="$source_relative/profile1.journal"
    origin_output=$(container bash -c '
        set -euo pipefail
        readonly cargo_home=/tmp/nexus-schema5-fixture-cargo-home
        mkdir -p "$cargo_home"
        ln -s /root/.cargo/registry "$cargo_home/registry"
        CARGO_HOME="$cargo_home" \
            CARGO_TARGET_DIR=/tmp/nexus-schema5-fixture-target \
            cargo run --offline -q --locked \
                --manifest-path "$1/Cargo.toml" \
                -p cser-core --features std --bin cser-restart-fixture \
                -- origin "$2"
    ' _ "/work/$source_relative" "/work/$logical_relative")
    legacy_catalog=$(container bash -c '
        set -euo pipefail
        readonly cargo_home=/tmp/nexus-schema5-catalog-cargo-home
        mkdir -p "$cargo_home"
        ln -s /root/.cargo/registry "$cargo_home/registry"
        CARGO_HOME="$cargo_home" \
            CARGO_TARGET_DIR=/tmp/nexus-schema5-catalog-target \
            cargo run --offline -q --locked \
                --manifest-path "$1/Cargo.toml" \
                -p cser-core --features std --bin cser-catalog-digest
    ' _ "/work/$source_relative")
    if [[ $origin_output != "$core_schema5_fixture_revision_number $core_schema5_fixture_head" ]] \
        || [[ $legacy_catalog != "$core_schema5_fixture_catalog" ]]; then
        echo 'frozen profile-1 encoder returned unexpected semantic coordinates' >&2
        return 1
    fi

    logical_len=$(stat -c %s -- "$source_dir/profile1.journal")
    logical_sha=$(sha256sum "$source_dir/profile1.journal" | cut -d ' ' -f1)
    final_head=$(tail -c 32 "$source_dir/profile1.journal" | xxd -p -c 32)
    if [[ $logical_len != 1285 \
        || $logical_sha != "$core_schema5_fixture_logical_sha" \
        || $final_head != "$core_schema5_fixture_head" \
        || $(xxd -p -l 8 "$source_dir/profile1.journal") != 435345524a523500 ]]; then
        echo 'frozen profile-1 logical journal does not match its pinned fixture' >&2
        return 1
    fi
    cp -- "$source_dir/profile1.journal" "$core_schema5_logical_journal"

    payload_sha=$(sha256sum "$core_schema5_logical_journal" | cut -d ' ' -f1)
    logical_len_hex=$(core_persistent_u64_le_hex "$logical_len")
    header_prefix_hex="4353455250494f0001007000000000000100000000000000${logical_len_hex}00000100000000000000000000000000${payload_sha}"
    header_file="$source_dir/pio-header.bin"
    printf '%s' "$header_prefix_hex" | xxd -r -p >"$header_file"
    if [[ $(stat -c %s -- "$header_file") != 80 ]]; then
        echo 'schema-5 PIO bank header prefix has the wrong length' >&2
        return 1
    fi
    header_sha=$(sha256sum "$header_file" | cut -d ' ' -f1)
    printf '%s' "$header_sha" | xxd -r -p >>"$header_file"
    truncate -s 512 "$header_file"

    truncate -s 0 "$core_persistent_journal"
    truncate -s 4M "$core_persistent_journal"
    dd if="$header_file" of="$core_persistent_journal" \
        bs=512 seek=1 conv=notrunc status=none
    dd if="$core_schema5_logical_journal" of="$core_persistent_journal" \
        bs=512 seek=2 conv=notrunc status=none
    chmod 0600 "$core_persistent_journal"
    cmp "$header_file" <(dd if="$core_persistent_journal" bs=512 skip=1 count=1 status=none)
    cmp "$core_schema5_logical_journal" \
        <(dd if="$core_persistent_journal" bs=1 skip=1024 count="$logical_len" status=none)
    pio_sha=$(sha256sum "$core_persistent_journal" | cut -d ' ' -f1)
    cp -- "$core_persistent_journal" "$core_schema5_journal"
    {
        printf '%s\n' nexus.cser.schema5-selected-fixture.v1
        printf 'profile1_source_revision=%s\n' "$core_schema5_fixture_revision"
        printf 'profile1_source_archive_sha256=%s\n' "$source_archive_sha"
        printf 'profile1_catalog_digest=%s\n' "$legacy_catalog"
        printf 'selected_revision=%s\n' "$core_schema5_fixture_revision_number"
        printf 'selected_head=%s\n' "$core_schema5_fixture_head"
        printf 'logical_journal_bytes=%s\n' "$logical_len"
        printf 'logical_journal_sha256=%s\n' "$logical_sha"
        printf 'pio_bank_generation=1\n'
        printf 'pio_bank_payload_sha256=%s\n' "$payload_sha"
        printf 'pio_image_sha256=%s\n' "$pio_sha"
        printf 'fixture_role=offline-profile1-encoder-no-production-decoder\n'
    } >"$core_schema5_fixture_metadata"
    echo "CSER_SCHEMA5_SELECTED_FIXTURE PASS source_revision=$core_schema5_fixture_revision revision=$core_schema5_fixture_revision_number head=$core_schema5_fixture_head logical_sha256=$logical_sha pio_sha256=$pio_sha"
)

assert_core_schema5_post_quarantine_trace() {
    local trace=$1
    local marker=$2
    local empty_isr_reads
    for field in \
        'bus_master_disabled=true' \
        'intx_masked=true' \
        'reset_status_zero=true' \
        'observed_isr_bits=0' \
        'iotlb_used_remapped_iova=true'; do
        if [[ " $marker " != *" $field "* ]]; then
            echo "schema-5 quarantine marker lacks $field" >&2
            return 1
        fi
    done
    core_schema5_marker_decimal_at_least "$marker" isr_reads 2 >/dev/null || return 1
    empty_isr_reads=$(core_schema5_marker_decimal_at_least \
        "$marker" consecutive_empty_isr_reads 2) || return 1
    if [[ $empty_isr_reads != 2 ]]; then
        echo "schema-5 quarantine marker requires exactly two terminal empty ISR reads, got $empty_isr_reads" >&2
        return 1
    fi
    core_schema5_marker_decimal_at_least \
        "$marker" iotlb_completed_trigger_pages 1 >/dev/null || return 1
    awk '
        function hex_value(value,    i, digit, result, character) {
            sub(/^0x/, "", value)
            result = 0
            for (i = 1; i <= length(value); i++) {
                character = substr(value, i, 1)
                if (character >= "0" && character <= "9")
                    digit = character + 0
                else if (character >= "a" && character <= "f")
                    digit = index("abcdef", character) + 9
                else
                    return -1
                result = result * 16 + digit
            }
            return result
        }

        function command_word(value) {
            value = hex_value(value)
            return value < 0 ? -1 : value % 65536
        }

        function bit_is_set(value, divisor) {
            return int(value / divisor) % 2
        }

        function boot_fence_command(value) {
            if (!bit_is_set(value, 2))
                value += 2
            if (bit_is_set(value, 4))
                value -= 4
            if (!bit_is_set(value, 1024))
                value += 1024
            return value
        }

        function command_is_quarantined(value) {
            return value >= 0 && !bit_is_set(value, 4) &&
                   bit_is_set(value, 1024)
        }

        function abandon_candidate() {
            fence_write_line = 0
            fence_command = -1
            fence_read_line = 0
            reset_line = 0
            iotlb_line = 0
            iotlb_wait_line = 0
        }

        # QEMU 9.2 reports PCI status and command together on reads, but only
        # the 16-bit command on writes. Locate the last exact boot-fence
        # read/write/readback transaction before reset and IOTLB completion.
        # Firmware activity before that transaction is outside the quarantine
        # interval. BAR discovery may toggle decode bits afterwards, but may
        # never restore BUS_MASTER or unmask INTx.
        $1 == "pci_cfg_read" && $3 == "00:05.0" && $4 == "@0x4" && $5 == "->" {
            command = command_word($6)
            if (command < 0) {
                bad = 1
                next
            }
            if (fence_write_line && !fence_read_line) {
                if (command == fence_command)
                    fence_read_line = FNR
                else
                    abandon_candidate()
            } else if (fence_read_line && !command_is_quarantined(command)) {
                abandon_candidate()
            }
            previous_command = command
            previous_command_line = FNR
            next
        }

        $1 == "pci_cfg_write" && $3 == "00:05.0" && $4 == "@0x4" && $5 == "<-" {
            command = command_word($6)
            if (command < 0) {
                bad = 1
                next
            }
            if (iotlb_wait_line) {
                if (!command_is_quarantined(command))
                    bad = 1
                next
            }
            if (fence_read_line && !command_is_quarantined(command))
                abandon_candidate()
            if (previous_command_line &&
                command == boot_fence_command(previous_command)) {
                fence_write_line = FNR
                fence_command = command
                fence_read_line = 0
                reset_line = 0
                iotlb_line = 0
                iotlb_wait_line = 0
            }
            next
        }

        fence_read_line && !reset_line && $1 == "virtio_set_status" {
            if (NF != 5 || $2 != "vdev" || $3 !~ /^0x[0-9a-f]+$/ ||
                $4 != "val") {
                bad = 1
            } else if ($5 == "0") {
                reset_line = FNR
            } else {
                abandon_candidate()
            }
            next
        }

        reset_line && !iotlb_line &&
            $0 == "vtd_inv_desc_iotlb_global iotlb invalidate global" {
            iotlb_line = FNR
            next
        }

        iotlb_line && !iotlb_wait_line &&
            $0 == "vtd_inv_desc_wait_irq IM in IECTL_REG is set, new event not generated" {
            iotlb_wait_line = FNR
            next
        }

        $1 == "vtd_dmar_fault" { bad = 1; next }
        iotlb_line && $1 == "virtio_pci_notify_write" { bad = 1; next }
        iotlb_line && $1 == "virtio_queue_notify" { bad = 1; next }
        iotlb_line && $1 == "virtio_notify" { bad = 1; next }
        iotlb_line && $1 == "vtd_dmar_translate" && $3 == "00:05.00" { bad = 1; next }
        iotlb_line && $1 == "virtio_set_status" && $4 == "val" && $5 != "0" { bad = 1; next }

        END {
            exit !(fence_write_line && fence_read_line && reset_line &&
                   iotlb_line && iotlb_wait_line &&
                   fence_write_line < fence_read_line &&
                   fence_read_line < reset_line && reset_line < iotlb_line &&
                   iotlb_line < iotlb_wait_line && !bad)
        }
    ' "$trace"
}

core_schema5_marker_decimal_at_least() {
    local marker=$1
    local field=$2
    local minimum=$3
    local token value= count=0
    for token in $marker; do
        if [[ $token == "$field="* ]]; then
            value=${token#*=}
            ((count += 1))
        fi
    done
    if (( count != 1 )) || [[ ! $value =~ ^(0|[1-9][0-9]*)$ ]]; then
        echo "schema-5 quarantine marker has invalid $field: $marker" >&2
        return 1
    fi
    if (( ${#value} < ${#minimum} )) \
        || { (( ${#value} == ${#minimum} )) && [[ $value < $minimum ]]; }; then
        echo "schema-5 quarantine marker has $field below $minimum: $marker" >&2
        return 1
    fi
    printf '%s\n' "$value"
}

core_schema5_tpm_snapshot_field() {
    local snapshot=$1
    local field=$2
    local expression=$3
    local value count
    value=$(awk -F= -v key="$field" '
        $1 == key { count += 1; value = $2 }
        END { if (count == 1) print value; else exit 1 }
    ' "$snapshot") || return 1
    if [[ ! $value =~ $expression ]]; then
        echo "schema-5 TPM snapshot has invalid $field in $snapshot" >&2
        return 1
    fi
    printf '%s\n' "$value"
}

assert_core_schema5_tpm_nv_snapshot() {
    local snapshot=$1
    local tip_counter lease_counter tip_slot lease_slot
    local tip_index lease_index header expected
    header=$(head -n 1 "$snapshot")
    if [[ $header != nexus.cser.schema5-tpm-selected-nv.v1 ]]; then
        echo "schema-5 TPM snapshot has an invalid header: $snapshot" >&2
        return 1
    fi
    tip_counter=$(core_schema5_tpm_snapshot_field "$snapshot" \
        tip_counter_hex '^[0-9a-f]{16}$') || return 1
    lease_counter=$(core_schema5_tpm_snapshot_field "$snapshot" \
        lease_counter_hex '^[0-9a-f]{16}$') || return 1
    tip_slot=$(core_schema5_tpm_snapshot_field "$snapshot" \
        tip_selected_slot '^[01]$') || return 1
    lease_slot=$(core_schema5_tpm_snapshot_field "$snapshot" \
        lease_selected_slot '^[01]$') || return 1
    tip_index=$(core_schema5_tpm_snapshot_field "$snapshot" \
        tip_selected_slot_index '^0x0180010[12]$') || return 1
    lease_index=$(core_schema5_tpm_snapshot_field "$snapshot" \
        lease_selected_slot_index '^0x0180010[45]$') || return 1
    core_schema5_tpm_snapshot_field "$snapshot" \
        tip_selected_slot_sha256 '^[0-9a-f]{64}$' >/dev/null || return 1
    core_schema5_tpm_snapshot_field "$snapshot" \
        lease_selected_slot_sha256 '^[0-9a-f]{64}$' >/dev/null || return 1
    core_schema5_tpm_snapshot_field "$snapshot" \
        selected_coordinate_digest '^[0-9a-f]{64}$' >/dev/null || return 1
    expected=$((16#${tip_counter: -1} & 1))
    if (( tip_slot != expected )) || [[ $tip_index != "0x0180010$((tip_slot + 1))" ]]; then
        echo "schema-5 TPM snapshot has an inconsistent selected tip coordinate: $snapshot" >&2
        return 1
    fi
    expected=$((16#${lease_counter: -1} & 1))
    if (( lease_slot != expected )) || [[ $lease_index != "0x0180010$((lease_slot + 4))" ]]; then
        echo "schema-5 TPM snapshot has an inconsistent selected lease coordinate: $snapshot" >&2
        return 1
    fi
}

assert_core_schema5_tpm_nv_unchanged() {
    local before=$1
    local after=$2
    assert_core_schema5_tpm_nv_snapshot "$before" || return 1
    assert_core_schema5_tpm_nv_snapshot "$after" || return 1
    if ! cmp -s "$before" "$after"; then
        echo 'schema-5 negative boot advanced or rewrote selected TPM NV state' >&2
        return 1
    fi
}

capture_core_schema5_tpm_nv_snapshot() (
    set -euo pipefail
    local state_dir=$1
    local output=$2
    local work_dir socket control_socket pid_file tcti flags capabilities
    local swtpm_pid= tip_counter_hex lease_counter_hex
    local tip_slot lease_slot tip_index lease_index selected_digest
    local lock_key lock_file observed_pid
    umask 077
    if [[ ! -d $state_dir ]]; then
        echo "schema-5 TPM snapshot state directory is missing: $state_dir" >&2
        return 1
    fi
    lock_key=$(printf '%s' "$state_dir" | sha256sum | cut -c1-32)
    lock_file="/tmp/cser-schema5-tpm-snapshot-$lock_key.lock"
    exec 9>"$lock_file"
    if ! flock -n 9; then
        echo "schema-5 TPM snapshot state directory is already owned: $state_dir" >&2
        return 1
    fi
    # Unix-domain pathname limits are smaller than this artifact directory on
    # some hosts. Keep only the ephemeral readback socket under /tmp.
    work_dir=$(mktemp -d /tmp/cser-schema5-tpm-readback.XXXXXX)
    socket="$work_dir/server.sock"
    # tpm2-tools derives the control path as "$server_socket.ctrl" from the
    # swtpm TCTI path, so this must remain coupled to the server name.
    control_socket="$socket.ctrl"
    pid_file="$work_dir/swtpm.pid"
    tcti="swtpm:path=$socket"
    cleanup_schema5_tpm_snapshot() {
        local status=$?
        if [[ -n ${swtpm_pid:-} ]] && kill -0 "$swtpm_pid" 2>/dev/null; then
            kill -KILL "$swtpm_pid" 2>/dev/null || true
            wait "$swtpm_pid" 2>/dev/null || true
        fi
        rm -rf -- "$work_dir"
        exit "$status"
    }
    trap cleanup_schema5_tpm_snapshot EXIT
    capabilities=$(swtpm socket --print-capabilities)
    # This reader has no firmware client to issue TPM2_Startup. startup-clear
    # initializes only volatile TPM state; the receipt still forbids any NV
    # counter/slot change across its selected-coordinate snapshots.
    flags=not-need-init,startup-clear
    if grep -Fq '"flags-opt-disable-auto-shutdown"' <<<"$capabilities"; then
        flags+=,disable-auto-shutdown
    fi
    swtpm socket \
        --tpm2 \
        --tpmstate "dir=$state_dir" \
        --ctrl "type=unixio,path=$control_socket" \
        --server "type=unixio,path=$socket" \
        --flags "$flags" \
        --pid "file=$pid_file" \
        --daemon
    for _ in {1..500}; do
        observed_pid=
        [[ -f $pid_file ]] && observed_pid=$(tr -d '\n' <"$pid_file")
        if [[ $observed_pid =~ ^[1-9][0-9]*$ ]] && [[ -S $socket ]] \
            && kill -0 "$observed_pid" 2>/dev/null; then
            swtpm_pid=$observed_pid
            break
        fi
        sleep 0.01
    done
    if [[ ! $swtpm_pid =~ ^[1-9][0-9]*$ ]] || [[ ! -S $socket ]] \
        || ! kill -0 "$swtpm_pid" 2>/dev/null; then
        echo 'schema-5 TPM snapshot swtpm did not start' >&2
        return 1
    fi
    tpm2_nvread -Q -T "$tcti" -C 0x01800100 -s 8 \
        -o "$work_dir/tip-counter.bin" 0x01800100
    tpm2_nvread -Q -T "$tcti" -C 0x01800103 -s 8 \
        -o "$work_dir/lease-counter.bin" 0x01800103
    tip_counter_hex=$(xxd -p -c 8 "$work_dir/tip-counter.bin")
    lease_counter_hex=$(xxd -p -c 8 "$work_dir/lease-counter.bin")
    if [[ ! $tip_counter_hex =~ ^[0-9a-f]{16}$ ]] \
        || [[ ! $lease_counter_hex =~ ^[0-9a-f]{16}$ ]]; then
        echo 'schema-5 TPM snapshot read a malformed counter' >&2
        return 1
    fi
    tip_slot=$((16#${tip_counter_hex: -1} & 1))
    lease_slot=$((16#${lease_counter_hex: -1} & 1))
    printf -v tip_index '0x0180010%x' "$((tip_slot + 1))"
    printf -v lease_index '0x0180010%x' "$((lease_slot + 4))"
    tpm2_nvread -Q -T "$tcti" -C "$tip_index" -s 180 \
        -o "$work_dir/tip-selected.bin" "$tip_index"
    tpm2_nvread -Q -T "$tcti" -C "$lease_index" -s 140 \
        -o "$work_dir/lease-selected.bin" "$lease_index"
    selected_digest=$( {
        printf '%s\n' "$tip_counter_hex" "$tip_slot" "$tip_index"
        sha256sum "$work_dir/tip-selected.bin" | cut -d ' ' -f1
        printf '%s\n' "$lease_counter_hex" "$lease_slot" "$lease_index"
        sha256sum "$work_dir/lease-selected.bin" | cut -d ' ' -f1
    } | sha256sum | cut -d ' ' -f1)
    {
        printf '%s\n' nexus.cser.schema5-tpm-selected-nv.v1
        printf 'tip_counter_index=0x01800100\n'
        printf 'tip_counter_hex=%s\n' "$tip_counter_hex"
        printf 'tip_selected_slot=%s\n' "$tip_slot"
        printf 'tip_selected_slot_index=%s\n' "$tip_index"
        printf 'tip_selected_slot_sha256=%s\n' "$(sha256sum "$work_dir/tip-selected.bin" | cut -d ' ' -f1)"
        printf 'lease_counter_index=0x01800103\n'
        printf 'lease_counter_hex=%s\n' "$lease_counter_hex"
        printf 'lease_selected_slot=%s\n' "$lease_slot"
        printf 'lease_selected_slot_index=%s\n' "$lease_index"
        printf 'lease_selected_slot_sha256=%s\n' "$(sha256sum "$work_dir/lease-selected.bin" | cut -d ' ' -f1)"
        printf 'selected_coordinate_digest=%s\n' "$selected_digest"
    } >"$output"
    assert_core_schema5_tpm_nv_snapshot "$output"
)

selftest_core_schema5_negative_oracles() (
    local tmp valid_trace missing_readback_trace bus_master_trace late_notify_trace
    local before_snapshot after_snapshot live_state valid_marker
    tmp=$(mktemp -d)
    trap 'rm -rf -- "$tmp"' EXIT
    valid_trace="$tmp/valid.trace"
    missing_readback_trace="$tmp/missing-readback.trace"
    bus_master_trace="$tmp/bus-master.trace"
    late_notify_trace="$tmp/late-notify.trace"
    before_snapshot="$tmp/before.snapshot"
    after_snapshot="$tmp/after.snapshot"
    valid_marker='CSER_CORE_SCHEMA5_MIGRATION_REQUIRED PASS bus_master_disabled=true intx_masked=true reset_status_zero=true observed_isr_bits=0 isr_reads=2 consecutive_empty_isr_reads=2 iotlb_used_remapped_iova=true iotlb_completed_trigger_pages=1'
    printf '%s\n' \
        'pci_cfg_write virtio-blk-pci 00:05.0 @0x4 <- 0x7' \
        'pci_cfg_read virtio-blk-pci 00:05.0 @0x4 -> 0x100007' \
        'pci_cfg_write virtio-blk-pci 00:05.0 @0x4 <- 0x403' \
        'pci_cfg_read virtio-blk-pci 00:05.0 @0x4 -> 0x100403' \
        'virtio_set_status vdev 0x1 val 0' \
        'vtd_inv_desc_iotlb_global iotlb invalidate global' \
        'vtd_inv_desc_wait_irq IM in IECTL_REG is set, new event not generated' \
        >"$valid_trace"
    if ! assert_core_schema5_post_quarantine_trace \
        "$valid_trace" "$valid_marker" >/dev/null 2>&1; then
        echo 'schema-5 quarantine oracle self-test rejected its positive trace' >&2
        return 1
    fi
    grep -Fv 'pci_cfg_read ' "$valid_trace" >"$missing_readback_trace"
    if assert_core_schema5_post_quarantine_trace \
        "$missing_readback_trace" "$valid_marker" >/dev/null 2>&1; then
        echo 'schema-5 quarantine oracle accepted a fence without command readback' >&2
        return 1
    fi
    sed 's/@0x4 <- 0x403/@0x4 <- 0x407/' "$valid_trace" >"$bus_master_trace"
    if assert_core_schema5_post_quarantine_trace \
        "$bus_master_trace" "$valid_marker" >/dev/null 2>&1; then
        echo 'schema-5 quarantine oracle accepted bus mastering after the fence' >&2
        return 1
    fi
    cp "$valid_trace" "$late_notify_trace"
    printf '%s\n' 'virtio_pci_notify_write 0x0 = 0x0 (2)' >>"$late_notify_trace"
    if assert_core_schema5_post_quarantine_trace \
        "$late_notify_trace" "$valid_marker" >/dev/null 2>&1; then
        echo 'schema-5 quarantine oracle accepted post-IOTLB VirtIO notification' >&2
        return 1
    fi

    printf '%s\n' \
        'nexus.cser.schema5-tpm-selected-nv.v1' \
        'tip_counter_index=0x01800100' \
        'tip_counter_hex=0000000000000001' \
        'tip_selected_slot=1' \
        'tip_selected_slot_index=0x01800102' \
        'tip_selected_slot_sha256=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' \
        'lease_counter_index=0x01800103' \
        'lease_counter_hex=0000000000000001' \
        'lease_selected_slot=1' \
        'lease_selected_slot_index=0x01800105' \
        'lease_selected_slot_sha256=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb' \
        'selected_coordinate_digest=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc' \
        >"$before_snapshot"
    cp "$before_snapshot" "$after_snapshot"
    if ! assert_core_schema5_tpm_nv_unchanged \
        "$before_snapshot" "$after_snapshot" >/dev/null 2>&1; then
        echo 'schema-5 TPM snapshot self-test rejected identical selected NV state' >&2
        return 1
    fi
    sed 's/selected_coordinate_digest=cccc/selected_coordinate_digest=dddd/' \
        "$after_snapshot" >"$tmp/changed.snapshot"
    if assert_core_schema5_tpm_nv_unchanged \
        "$before_snapshot" "$tmp/changed.snapshot" >/dev/null 2>&1; then
        echo 'schema-5 TPM snapshot self-test accepted a changed selected NV digest' >&2
        return 1
    fi
    live_state=$(mktemp -d "$tmp/tpmstate.XXXXXX")
    bash "$root/scripts/provision-cser-tpm-nv.sh" \
        "$live_state" "$core_schema5_fixture_catalog" \
        "$core_schema5_fixture_revision_number" "$core_schema5_fixture_head" \
        >/dev/null
    capture_core_schema5_tpm_nv_snapshot "$live_state" "$tmp/live-before.snapshot"
    capture_core_schema5_tpm_nv_snapshot "$live_state" "$tmp/live-after.snapshot"
    if ! assert_core_schema5_tpm_nv_unchanged \
        "$tmp/live-before.snapshot" "$tmp/live-after.snapshot" >/dev/null 2>&1; then
        echo 'schema-5 TPM snapshot self-test changed real selected NV state' >&2
        return 1
    fi
    echo 'schema-5 negative oracle self-test: PASS fence_readback=rejected_when_missing bus_master=rejected post_iotlb_notify=rejected selected_tpm_nv_change=rejected real_swtpm_readback=unchanged'
)

