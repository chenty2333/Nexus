doctor() {
    local tool
    for tool in awk bash chmod cmp cp cut dd diff dirname find flock git grep head id \
        mkdir mkfifo mktemp mv rm sed sha256sum sort stat swtpm tail tar tee timeout truncate \
        tpm2_flushcontext tpm2_nvincrement tpm2_nvdefine tpm2_nvread \
        tpm2_nvreadpublic tpm2_nvwrite tpm2_policycommandcode \
        tpm2_startauthsession tr wc xxd; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            echo "nexus-ostd doctor: missing host tool: $tool" >&2
            return 1
        fi
    done
    if ! command "$docker_bin" info >/dev/null 2>&1; then
        echo 'nexus-ostd doctor: Docker daemon is unavailable' >&2
        return 1
    fi
    for input in \
        "$root/Cargo.toml" \
        "$root/Cargo.lock" \
        "$root/Dockerfile" \
