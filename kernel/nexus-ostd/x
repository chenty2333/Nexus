        bindings+=("$coordinate")
    done
    for index in 0 1 2 3; do
        expected=$((index + 1))
        if (( 10#${principals[$index]} != expected )) \
            || (( 10#${bindings[$index]} != expected )); then
            echo "persistent service identity is not the exact fresh boot $expected pair" >&2
