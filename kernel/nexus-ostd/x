#!/usr/bin/bash -p
set -euo pipefail

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
readonly PATH
root=$(cd "$(/usr/bin/dirname "$0")" && pwd)
repo_root=$(cd "$root/../.." && pwd)
docker_bin=/usr/bin/docker
if [[ ! -f $docker_bin || ! -x $docker_bin || -L $docker_bin ]] \
    || [[ $(/usr/bin/realpath -e -- "$docker_bin") != "$docker_bin" ]]; then
    echo "Docker CLI must be the non-symlink executable $docker_bin" >&2
    exit 1
fi
readonly docker_bin
capture_helper="$root/scripts/qemu-stream-capture.sh"
capture_helper_sha256=b05544fb66e5d124fb141696accb1933742de561469f1c9e4a12eef3c6c5e7b7
if [[ ! -f $capture_helper || -L $capture_helper ]] \
    || [[ $(/usr/bin/realpath -e -- "$capture_helper") != "$capture_helper" ]]; then
    echo "QEMU capture helper must be a non-symlink regular file: $capture_helper" >&2
    exit 1
fi
if [[ $(/usr/bin/sha256sum -- "$capture_helper" | /usr/bin/cut -d ' ' -f1) \
    != "$capture_helper_sha256" ]]; then
    echo "QEMU capture helper source drifted: $capture_helper" >&2
    exit 1
fi
readonly capture_helper capture_helper_sha256
repo_lock="/tmp/nexus-workflow-${repo_root//\//_}.lock"
kernel_lock="/tmp/nexus-kernel-${root//\//_}.lock"
if [[ ${NEXUS_ROOT_LOCK_HELD:-0} != 1 ]]; then
    exec 8>"$repo_lock"
    flock 8
fi
exec 9>"$kernel_lock"
flock 9
production_source_manifest="$root/cser-production-sources.txt"
if [[ ! -f $production_source_manifest || -L $production_source_manifest ]] \
    || [[ $(realpath -e -- "$production_source_manifest") != "$production_source_manifest" ]]; then
    echo "CSER production source manifest must be a non-symlink regular file: $production_source_manifest" >&2
    exit 1
fi
mapfile -t cser_production_sources <"$production_source_manifest"
declare -a cser_source_hash_inputs=()
declare -a cser_source_mount_args=()
previous_production_source=
for relative in "${cser_production_sources[@]}"; do
    if [[ ! $relative =~ ^[a-z0-9_./-]+\.rs$ ]] \
        || [[ $relative == /* || $relative == ./* || $relative == *"/./"* ]] \
        || [[ $relative == *".."* || $relative == *"//"* ]]; then
        echo "invalid CSER production source path: $relative" >&2
        exit 1
    fi
    if [[ -n $previous_production_source && ! $previous_production_source < $relative ]]; then
        echo "CSER production source manifest is not strictly sorted: $relative" >&2
        exit 1
    fi
    source_path="$root/src/cser/$relative"
    target_path="/kernel/nexus-ostd/src/cser/$relative"
    if [[ ! -f $source_path || -L $source_path ]] \
        || [[ $(realpath -e -- "$source_path") != "$source_path" ]]; then
        echo "CSER production source must be a non-symlink regular file: $source_path" >&2
        exit 1
    fi
    cser_source_hash_inputs+=("$source_path")
    cser_source_mount_args+=(--mount "type=bind,source=$source_path,target=$target_path,readonly")
    previous_production_source=$relative
done
if ((${#cser_production_sources[@]} == 0)); then
    echo "CSER production source manifest is empty" >&2
    exit 1
fi
readonly production_source_manifest
readonly -a cser_production_sources cser_source_hash_inputs cser_source_mount_args
mapfile -d '' -t cser_model_image_inputs < <(
    find "$repo_root/crates/cser-model" -type f -print0 | sort -z
)
if ((${#cser_model_image_inputs[@]} == 0)) \
    || find "$repo_root/crates/cser-model" -type l -print -quit | grep -q .; then
    echo "cser-model image inputs must be non-empty regular files without symlinks" >&2
    exit 1
fi
readonly -a cser_model_image_inputs
# Hash only inputs consumed while building the pinned image. Runtime serial
# oracles execute from the mounted worktree and must not force an image rebuild.
image_key=$(sha256sum \
    "$repo_root/Cargo.toml" \
    "$repo_root/Cargo.lock" \
    "$root/Dockerfile" \
    "$root/.dockerignore" \
    "$repo_root/.dockerignore" \
    "$repo_root/tests/guest/linux/sources/linux-runtime-fs-smoke/runtime_fs_smoke.S" \
    "$root/Cargo.toml" \
    "$root/Cargo.lock" \
    "$root/OSDK.toml" \
    "$root/rust-toolchain.toml" \
    "$root/osdk-runner-base/Cargo.toml" \
    "$root/osdk-runner-base/Cargo.lock" \
    "$root/osdk-runner-base/src/main.rs" \
    "$root/osdk-runner-base/x86_64.ld" \
    "$root/osdk-runner-base/riscv64.ld" \
    "$root/osdk-runner-base/loongarch64.ld" \
    "$root/scripts/build-runtime-fs.sh" \
    "$root/scripts/assert-runtime-fs-artifacts.sh" \
    "$root/scripts/build-runtime-fs-block-image.sh" \
    "$root/scripts/assert-runtime-fs-block-image.sh" \
    "$repo_root/crates/cser-core/Cargo.toml" \
    "$repo_root/crates/cser-core/src/domain.rs" \
    "$repo_root/crates/cser-core/src/engine.rs" \
    "$repo_root/crates/cser-core/src/identity.rs" \
    "$repo_root/crates/cser-core/src/journal.rs" \
    "$repo_root/crates/cser-core/src/lib.rs" \
    "$repo_root/crates/cser-core/src/persistence.rs" \
    "$repo_root/crates/cser-core/src/profiles.rs" \
    "$repo_root/crates/cser-core/src/bin/cser-catalog-digest.rs" \
    "${cser_model_image_inputs[@]}" \
    "$repo_root/crates/nexus-ostd-virtio/Cargo.toml" \
    "$repo_root/crates/nexus-ostd-virtio/Cargo.lock" \
    "$repo_root/crates/nexus-ostd-virtio/README.md" \
    "$repo_root/crates/nexus-ostd-virtio/src/boot_quarantine.rs" \
    "$repo_root/crates/nexus-ostd-virtio/src/lib.rs" \
    "$repo_root/crates/nexus-ostd-virtio/src/dma.rs" \
    "$repo_root/crates/nexus-ostd-virtio/src/pci.rs" \
    "$repo_root/crates/nexus-ostd-virtio/src/production.rs" \
    "$repo_root/patches/ostd-0.18.0-cser.patch" \
    "$repo_root/patches/virtio-drivers-0.13.0-cser.patch" \
    "$repo_root/patches/virtio-drivers-0.13.0-LICENSE-MIT" \
    "$repo_root/patches/cser-cargo-config.toml" \
    "$repo_root/tools/ostd/assert-cser-patch.sh" \
    "$repo_root/tools/virtio/assert-cser-patch.sh" \
    "$repo_root/tools/virtio/assert-production-substrate.sh" \
    "$production_source_manifest" \
    "${cser_source_hash_inputs[@]}" | cut -d ' ' -f1 | sha256sum | cut -c1-16)
image="nexus/nexus-ostd:$image_key"
runner_base="$root/osdk-runner-base"
runner_target="$root/target/osdk/nexus-kernel-run-base"

build_image() {
    local -a rebuild_args=()
    if [[ ${NEXUS_REBUILD:-0} == 1 ]]; then
        rebuild_args=(--no-cache)
    fi
    command "$docker_bin" build \
        "${rebuild_args[@]}" \
        --platform linux/amd64 \
        --file "$root/Dockerfile" \
        --tag "$image" \
        "$repo_root"
}

container() {
    local -a cpu_args=()
    local -a security_args=()
    if [[ -n ${NEXUS_CONTAINER_CPUSET:-} ]]; then
        cpu_args=(--cpuset-cpus "$NEXUS_CONTAINER_CPUSET")
    fi
    if [[ ${NEXUS_CONTAINER_HOST_UNIX_SOCKET:-0} == 1 ]]; then
        # Fedora SELinux denies a container-domain process access to a Unix
        # socket created by host swtpm even after the bind tree is relabeled.
        # This opt-out is used only by the isolated TPM fixture container; the
        # default build and every production workflow retain Docker labeling.
        security_args=(--security-opt label=disable)
    fi
    command "$docker_bin" run --rm \
        --init \
        "${cpu_args[@]}" \
        "${security_args[@]}" \
        --platform linux/amd64 \
        --network none \
        --user "$(id -u):$(id -g)" \
        --env HOME=/tmp/nexus-home \
        --tmpfs /tmp/nexus-home:rw,exec,nosuid,size=64m,mode=1777 \
        -v "$root:/work:z" \
        -v "$repo_root:/repo:ro,z" \
        -v "$repo_root/crates/cser-core:/crates/cser-core:ro,z" \
        -v "$repo_root/crates/cser-model:/crates/cser-model:ro,z" \
        -v "$repo_root/crates/nexus-ostd-virtio:/crates/nexus-ostd-virtio:ro,z" \
        "${cser_source_mount_args[@]}" \
        --mount "type=bind,source=$root/Cargo.lock,target=/work/Cargo.lock,readonly" \
        -w /work \
        "$image" \
        "$@"
}

ensure_image() {
    if [[ ${NEXUS_REBUILD:-0} == 1 ]] \
        || ! command "$docker_bin" image inspect "$image" >/dev/null 2>&1; then
        build_image
    fi
}

check_ostd_patch() {
    container /repo/tools/ostd/assert-cser-patch.sh \
        /repo/patches/ostd-0.18.0-cser.patch \
        /opt/nexus-ostd/ostd-0.18.0
    container bash -c '
        set -euo pipefail
        tmp=$(mktemp -d)
        trap '\''rm -rf "$tmp"'\'' EXIT

        cp /repo/patches/ostd-0.18.0-cser.patch "$tmp/mutated.patch"
        sed -i '\''0,/const RTE_LEVEL_TRIGGERED: u32 = 1 << 15;/s//const RTE_LEVEL_TRIGGERED: u32 = 1 << 14;/'\'' \
            "$tmp/mutated.patch"
        if /repo/tools/ostd/assert-cser-patch.sh \
            "$tmp/mutated.patch" /opt/nexus-ostd/ostd-0.18.0 >/dev/null 2>&1; then
            echo "kernel OSTD gate accepted a mutated canonical patch" >&2
            exit 1
        fi

        cp -a /opt/nexus-ostd/ostd-0.18.0 "$tmp/mutated-source"
        sed -i '\''s/const RTE_ACTIVE_LOW: u32 = 1 << 13;/const RTE_ACTIVE_LOW: u32 = 1 << 12;/'\'' \
            "$tmp/mutated-source/src/arch/x86/irq/chip/ioapic.rs"
        if /repo/tools/ostd/assert-cser-patch.sh \
            /repo/patches/ostd-0.18.0-cser.patch "$tmp/mutated-source" >/dev/null 2>&1; then
            echo "kernel OSTD gate accepted a mutated installed source tree" >&2
            exit 1
        fi
        echo "canonical OSTD negative assertions: PASS patch_mutation=rejected source_mutation=rejected"
    '
}

check_virtio_patch() {
    container /repo/tools/virtio/assert-cser-patch.sh \
        /repo/patches/virtio-drivers-0.13.0-cser.patch \
        /opt/nexus-virtio/virtio-drivers-0.13.0 \
        /repo/patches/virtio-drivers-0.13.0-LICENSE-MIT
    container /repo/tools/virtio/assert-production-substrate.sh \
        /crates/nexus-ostd-virtio/src/production.rs \
        /crates/nexus-ostd-virtio/src/lib.rs \
        /crates/nexus-ostd-virtio/src/pci.rs
    container bash -c '
        set -euo pipefail
        tmp=$(mktemp -d)
        trap '\''rm -rf "$tmp"'\'' EXIT
        require_mutation() {
            if cmp -s "$1" "$2"; then
                echo "source mutation did not apply: $3" >&2
                exit 1
            fi
        }
        canonical=/repo/patches/virtio-drivers-0.13.0-cser.patch
        license=/repo/patches/virtio-drivers-0.13.0-LICENSE-MIT
        installed=/opt/nexus-virtio/virtio-drivers-0.13.0
        source=/crates/nexus-ostd-virtio/src/production.rs
        lib=/crates/nexus-ostd-virtio/src/lib.rs
        pci=/crates/nexus-ostd-virtio/src/pci.rs

        cp "$canonical" "$tmp/relaxed.patch"
        sed -i '\''0,/Ordering::Release/s//Ordering::Relaxed/'\'' "$tmp/relaxed.patch"
        if /repo/tools/virtio/assert-cser-patch.sh \
            "$tmp/relaxed.patch" "$installed" "$license" >/dev/null 2>&1; then
            echo "canonical VirtIO gate accepted Release-to-Relaxed mutation" >&2
            exit 1
        fi

        cp -a "$installed" "$tmp/missing-linear-owner"
        sed -i '\''0,/queue: ManuallyDrop<VirtQueue<H, SIZE>>,/s//queue: VirtQueue<H, SIZE>,/'\'' \
            "$tmp/missing-linear-owner/src/queue.rs"
        if /repo/tools/virtio/assert-cser-patch.sh \
            "$canonical" "$tmp/missing-linear-owner" "$license" >/dev/null 2>&1; then
            echo "canonical VirtIO gate accepted missing ManuallyDrop owner" >&2
            exit 1
        fi

        cp -a "$installed" "$tmp/missing-recycle"
        sed -i '\''s/self.recycle_descriptors(head, inputs, outputs);/let _ = (head, inputs, outputs);/'\'' \
            "$tmp/missing-recycle/src/queue.rs"
        if /repo/tools/virtio/assert-cser-patch.sh \
            "$canonical" "$tmp/missing-recycle" "$license" >/dev/null 2>&1; then
            echo "canonical VirtIO gate accepted missing exact-buffer recycle" >&2
            exit 1
        fi

        cp "$source" "$tmp/authority.rs"
        sed -i '\''2i use crate::EffectAuthority;'\'' "$tmp/authority.rs"
        if /repo/tools/virtio/assert-production-substrate.sh \
            "$tmp/authority.rs" "$lib" "$pci" >/dev/null 2>&1; then
            echo "production facade gate accepted semantic authority ownership" >&2
            exit 1
        fi

        cp "$source" "$tmp/post-release-assert.rs"
        sed -i '\''/let (queue, _token) = prepared.publish_prepared();/a\        assert!(true);'\'' \
            "$tmp/post-release-assert.rs"
        if /repo/tools/virtio/assert-production-substrate.sh \
            "$tmp/post-release-assert.rs" "$lib" "$pci" >/dev/null 2>&1; then
            echo "production facade gate accepted a post-Release assertion" >&2
            exit 1
        fi

        cp "$source" "$tmp/branching-generation.rs"
        sed -i '\''s/\*self.device_generation = self.next_generation;/if true { *self.device_generation = self.next_generation; }/'\'' \
            "$tmp/branching-generation.rs"
        if /repo/tools/virtio/assert-production-substrate.sh \
            "$tmp/branching-generation.rs" "$lib" "$pci" >/dev/null 2>&1; then
            echo "production facade gate accepted branching generation apply" >&2
            exit 1
        fi

        cp "$source" "$tmp/branching-quiescence.rs"
        sed -i '\''s/\*self.active = None;/if true { *self.active = None; }/'\'' \
            "$tmp/branching-quiescence.rs"
        if /repo/tools/virtio/assert-production-substrate.sh \
            "$tmp/branching-quiescence.rs" "$lib" "$pci" >/dev/null 2>&1; then
            echo "production facade gate accepted branching quiescence apply" >&2
            exit 1
        fi

        cp "$source" "$tmp/overlapping-session.rs"
        sed -i '\''0,/if self.active.is_some() {/s//if false {/'\'' \
            "$tmp/overlapping-session.rs"
        require_mutation "$source" "$tmp/overlapping-session.rs" overlapping-session
        if /repo/tools/virtio/assert-production-substrate.sh \
            "$tmp/overlapping-session.rs" "$lib" "$pci" >/dev/null 2>&1; then
            echo "production facade gate accepted overlapping hardware sessions" >&2
            exit 1
        fi

        cp "$source" "$tmp/forced-notification.rs"
        sed -i '\''0,/if self.queue.as_ref().expect("live queue").should_notify() {/s//if true {/'\'' \
            "$tmp/forced-notification.rs"
        require_mutation "$source" "$tmp/forced-notification.rs" forced-notification
        if /repo/tools/virtio/assert-production-substrate.sh \
            "$tmp/forced-notification.rs" "$lib" "$pci" >/dev/null 2>&1; then
            echo "production facade gate accepted mandatory notification despite suppression" >&2
            exit 1
        fi

        cp "$source" "$tmp/unchecked-used-length.rs"
        sed -i '\''0,/if used_len != EXPECTED_USED_LEN {/s//if false {/'\'' \
            "$tmp/unchecked-used-length.rs"
        require_mutation "$source" "$tmp/unchecked-used-length.rs" unchecked-used-length
        if /repo/tools/virtio/assert-production-substrate.sh \
            "$tmp/unchecked-used-length.rs" "$lib" "$pci" >/dev/null 2>&1; then
            echo "production facade gate accepted an unchecked device used length" >&2
            exit 1
        fi

        cp "$source" "$tmp/status-before-used-length.rs"
        sed -i '\''0,/if used_len != EXPECTED_USED_LEN {/i\        let response = request_buffers.response.status();'\'' \
            "$tmp/status-before-used-length.rs"
        require_mutation "$source" "$tmp/status-before-used-length.rs" status-before-used-length
        if /repo/tools/virtio/assert-production-substrate.sh \
            "$tmp/status-before-used-length.rs" "$lib" "$pci" >/dev/null 2>&1; then
            echo "production facade gate accepted status access before used-length validation" >&2
            exit 1
        fi

        cp "$source" "$tmp/irq-uses-polling-mode.rs"
        sed -i '\''0,/preflight_preparation_start(root, CompletionMode::Interrupt)/s//preflight_preparation_start(root, CompletionMode::Polling)/'\'' \
            "$tmp/irq-uses-polling-mode.rs"
        require_mutation "$source" "$tmp/irq-uses-polling-mode.rs" irq-uses-polling-mode
        if /repo/tools/virtio/assert-production-substrate.sh \
            "$tmp/irq-uses-polling-mode.rs" "$lib" "$pci" >/dev/null 2>&1; then
            echo "production facade gate accepted IRQ preparation with polling notifications" >&2
            exit 1
        fi

        cp "$source" "$tmp/irq-ack-spins.rs"
        sed -i '\''/pub fn ack_interrupt(&mut self) -> InterruptReceipt {/a\        core::hint::spin_loop();'\'' \
            "$tmp/irq-ack-spins.rs"
        require_mutation "$source" "$tmp/irq-ack-spins.rs" irq-ack-spins
        if /repo/tools/virtio/assert-production-substrate.sh \
            "$tmp/irq-ack-spins.rs" "$lib" "$pci" >/dev/null 2>&1; then
            echo "production facade gate accepted a spinning IRQ acknowledgement" >&2
            exit 1
        fi

        cp "$pci" "$tmp/cloneable-intx-token.rs"
        sed -i '\''0,/pub struct MaskedIntx {/s//#[derive(Clone)]\npub struct MaskedIntx {/'\'' \
            "$tmp/cloneable-intx-token.rs"
        require_mutation "$pci" "$tmp/cloneable-intx-token.rs" cloneable-intx-token
        if /repo/tools/virtio/assert-production-substrate.sh \
            "$source" "$lib" "$tmp/cloneable-intx-token.rs" >/dev/null 2>&1; then
            echo "production facade gate accepted a cloneable INTx owner token" >&2
            exit 1
        fi

        cp "$pci" "$tmp/reclaim-intx.rs"
        sed -i '\''/pub fn claim_masked_intx/,/pub fn unmask_intx/ {
            s/if self.intx_state != IntxOwnershipState::Unclaimed {/if false {/
        }'\'' \
            "$tmp/reclaim-intx.rs"
        require_mutation "$pci" "$tmp/reclaim-intx.rs" reclaim-intx
        if /repo/tools/virtio/assert-production-substrate.sh \
            "$source" "$lib" "$tmp/reclaim-intx.rs" >/dev/null 2>&1; then
            echo "production facade gate accepted repeated initial INTx claims" >&2
            exit 1
        fi

        cp "$pci" "$tmp/intx-command-collateral.rs"
        sed -i '\''0,/command.union(Command::INTERRUPT_DISABLE)/s//command.union(Command::INTERRUPT_DISABLE).union(Command::BUS_MASTER)/'\'' \
            "$tmp/intx-command-collateral.rs"
        require_mutation "$pci" "$tmp/intx-command-collateral.rs" intx-command-collateral
        if /repo/tools/virtio/assert-production-substrate.sh \
            "$source" "$lib" "$tmp/intx-command-collateral.rs" >/dev/null 2>&1; then
            echo "production facade gate accepted collateral PCI command mutation" >&2
            exit 1
        fi

        cp "$pci" "$tmp/intx-readback-forged.rs"
        sed -i '\''0,/let (_, observed) = root.inner.get_status_command(device_function);/s//let observed = expected;/'\'' \
            "$tmp/intx-readback-forged.rs"
        require_mutation "$pci" "$tmp/intx-readback-forged.rs" intx-readback-forged
        if /repo/tools/virtio/assert-production-substrate.sh \
            "$source" "$lib" "$tmp/intx-readback-forged.rs" >/dev/null 2>&1; then
            echo "production facade gate accepted forged PCI command readback" >&2
            exit 1
        fi

        cp "$pci" "$tmp/intx-owner-validation-bypassed.rs"
        sed -i '\''0,/if owner_id != self.intx_owner_id || route != self.intx_route {/s//if false {/'\'' \
            "$tmp/intx-owner-validation-bypassed.rs"
        require_mutation "$pci" "$tmp/intx-owner-validation-bypassed.rs" intx-owner-validation-bypassed
        if /repo/tools/virtio/assert-production-substrate.sh \
            "$source" "$lib" "$tmp/intx-owner-validation-bypassed.rs" >/dev/null 2>&1; then
            echo "production facade gate accepted bypassed INTx owner validation" >&2
            exit 1
        fi

        cp "$pci" "$tmp/intx-route-mint-bypass.rs"
        sed -i '\''/    pub const fn intx_route(&self) -> IntxRoute {/i\    pub fn mint_from_route(&self, route: IntxRoute) -> MaskedIntx { MaskedIntx { owner_id: self.intx_owner_id, epoch: 0, route } }'\'' \
            "$tmp/intx-route-mint-bypass.rs"
        require_mutation "$pci" "$tmp/intx-route-mint-bypass.rs" intx-route-mint-bypass
        if /repo/tools/virtio/assert-production-substrate.sh \
            "$source" "$lib" "$tmp/intx-route-mint-bypass.rs" >/dev/null 2>&1; then
            echo "production facade gate accepted descriptive-route token minting" >&2
            exit 1
        fi

        cp "$pci" "$tmp/intx-unmask-preread-bypass.rs"
        sed -i '\''0,/if !observed_before_unmask.contains(Command::INTERRUPT_DISABLE) {/s//if false {/'\'' \
            "$tmp/intx-unmask-preread-bypass.rs"
        require_mutation "$pci" "$tmp/intx-unmask-preread-bypass.rs" intx-unmask-preread-bypass
        if /repo/tools/virtio/assert-production-substrate.sh \
            "$source" "$lib" "$tmp/intx-unmask-preread-bypass.rs" >/dev/null 2>&1; then
            echo "production facade gate accepted unmask without a masked-command pre-read" >&2
            exit 1
        fi

        cp "$source" "$tmp/cloneable-hardware-intent.rs"
        sed -i '\''0,/pub struct PreparedCancelIntent {/s//#[derive(Clone)]\npub struct PreparedCancelIntent {/'\'' \
            "$tmp/cloneable-hardware-intent.rs"
        require_mutation "$source" "$tmp/cloneable-hardware-intent.rs" cloneable-hardware-intent
        if /repo/tools/virtio/assert-production-substrate.sh \
            "$tmp/cloneable-hardware-intent.rs" "$lib" "$pci" >/dev/null 2>&1; then
            echo "production facade gate accepted a cloneable hardware intent" >&2
            exit 1
        fi

        cp "$source" "$tmp/identity-only-hardware-intent.rs"
        sed -i '\''/pub struct PreparedCancelIntent {/,/^}/s/request: PreparedRequest,/identity: DeviceSessionIdentity,/'\'' \
            "$tmp/identity-only-hardware-intent.rs"
        require_mutation "$source" "$tmp/identity-only-hardware-intent.rs" identity-only-hardware-intent
        if /repo/tools/virtio/assert-production-substrate.sh \
            "$tmp/identity-only-hardware-intent.rs" "$lib" "$pci" >/dev/null 2>&1; then
            echo "production facade gate accepted an intent made from descriptive identity" >&2
            exit 1
        fi

        cp "$source" "$tmp/cancel-intent-preflight-bypassed.rs"
        sed -i '\''0,/if self.identity != expected_cancel_identity {/s//if false {/'\'' \
