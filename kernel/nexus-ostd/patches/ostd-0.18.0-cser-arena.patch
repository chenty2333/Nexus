@@ -169,3 +169,73 @@ pub(super) unsafe fn prepare_dma(pa_range: &Range<Paddr>) -> Option<Daddr> {
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(super) enum PrepareDmaAtError {
+    RemappingUnavailable,
+    InvalidDaddr,
+    DaddrUnavailable,
+}
+
+/// Prepares a physical address range at one exact device-address range.
+///
+/// Exact allocation failure happens before PFN tracking or PTE installation,
+/// so the caller can safely recover its unchanged backing segment. Once this
+/// function succeeds, only `complete_unprepare_dma` may return the exact range
+/// to the allocator.
+///
+/// # Safety
+///
+/// The provided physical address range must be untyped DMA memory that
+/// outlives the matching ownership-carrying unmap.
+pub(super) unsafe fn prepare_dma_at(
+    pa_range: &Range<Paddr>,
+    exact_daddr: Daddr,
+) -> Result<Daddr, PrepareDmaAtError> {
+    if !has_dma_remapping() {
+        return Err(PrepareDmaAtError::RemappingUnavailable);
+    }
+    if !exact_daddr.is_multiple_of(PAGE_SIZE) {
+        return Err(PrepareDmaAtError::InvalidDaddr);
+    }
+    let Some(end_daddr) = exact_daddr.checked_add(pa_range.len()) else {
+        return Err(PrepareDmaAtError::InvalidDaddr);
+    };
+    let daddr_range = exact_daddr..end_daddr;
+
+    let irq_guard = irq::disable_local();
+    #[cfg(target_arch = "x86_64")]
+    if allocator::daddr_allocator(&irq_guard)
+        .alloc_specific(&daddr_range)
+        .is_err()
+    {
+        drop(irq_guard);
+        return Err(PrepareDmaAtError::DaddrUnavailable);
+    }
+    #[cfg(not(target_arch = "x86_64"))]
+    {
+        drop(irq_guard);
+        return Err(PrepareDmaAtError::RemappingUnavailable);
+    }
+    #[cfg(target_arch = "x86_64")]
+    drop(irq_guard);
+
+    // SAFETY: The safety condition is upheld by the caller.
+    #[cfg(any(debug_assertions, all(target_arch = "x86_64", feature = "cvm_guest")))]
+    unsafe {
+        alloc_unprotect_physical_range(pa_range);
+    }
+
+    for map_paddr in pa_range.clone().step_by(PAGE_SIZE) {
+        let map_daddr = map_paddr - pa_range.start + exact_daddr;
+        // SAFETY: The caller guarantees that `map_paddr` is backed by the
+        // retained untyped segment. An unexpected map failure panics and
+        // deliberately retains both the exact IOVA and all installed PTEs.
+        unsafe {
+            iommu::map(map_daddr, map_paddr)
+                .expect("failed to install an exact DMA address mapping");
+        }
+    }
+
+    Ok(exact_daddr)
+}
