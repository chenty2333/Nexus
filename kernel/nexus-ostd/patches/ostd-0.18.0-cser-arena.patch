+/// Why an exact coherent DMA mapping could not be established.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum ExactDmaMapFailure {
+    /// The caller-supplied segment cannot use its ordinary coherent linear
+    /// mapping in a confidential guest.
+    ConfidentialGuest,
+    /// Exact device addresses require active DMA remapping.
+    DmaRemappingUnavailable,
+    /// The exact device address is unaligned or its range overflows.
+    InvalidDaddr,
+    /// Some part of the exact device-address range is still owned.
+    DaddrUnavailable,
+}
+
+/// An exact coherent DMA mapping failure that returns the caller's segment.
+#[derive(Debug)]
+pub struct ExactDmaMapError {
+    segment: Segment<()>,
+    failure: ExactDmaMapFailure,
+}
+
+impl ExactDmaMapError {
+    /// Returns the reason the exact mapping was rejected.
+    #[must_use]
+    pub const fn failure(&self) -> ExactDmaMapFailure {
+        self.failure
+    }
+
+    /// Returns the unchanged caller-owned segment.
+    #[must_use]
+    pub fn into_segment(self) -> Segment<()> {
+        self.segment
+    }
+
+    /// Returns both the rejection reason and unchanged segment.
+    #[must_use]
+    pub fn into_parts(self) -> (ExactDmaMapFailure, Segment<()>) {
+        (self.failure, self.segment)
+    }
+}
