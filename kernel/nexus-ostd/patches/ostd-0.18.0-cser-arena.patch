@@ -146,3 +187,60 @@ impl DmaCoherent {
+    /// Establishes a coherent DMA mapping for a caller-owned segment at one
+    /// exact device address.
+    ///
+    /// This constructor is intended for persistent DMA arenas that retain PFN
+    /// identity separately from the device-address allocator. It does not
+    /// initialize or otherwise modify the segment contents.
+    ///
+    /// The exact device-address range remains unavailable after teardown
+    /// begins. It can only be reserved again after
+    /// [`PendingDmaUnmap::poll_complete`] observes IOTLB completion and
+    /// releases the previous range.
+    ///
+    /// On any reported error, the returned [`ExactDmaMapError`] owns the
+    /// unchanged segment and no IOVA or IOMMU PTE was installed.
+    ///
+    /// This method [requires](crate::mm::dma#usage-in-irqs) the caller to
+    /// have IRQs enabled. The supplied segment is supported only for a
+    /// cache-coherent device in a non-confidential guest.
+    pub fn from_segment_at(
+        segment: Segment<()>,
+        exact_daddr: Daddr,
+    ) -> Result<Self, ExactDmaMapError> {
+        debug_assert!(irq::is_local_enabled());
+
+        if cvm_need_private_protection() {
+            return Err(ExactDmaMapError {
+                segment,
+                failure: ExactDmaMapFailure::ConfidentialGuest,
+            });
+        }
+
+        let paddr_range = segment.paddr_range();
+        // SAFETY: `segment` owns untyped physical memory and is moved into the
+        // returned DMA owner on success. Every reported failure precedes PFN
+        // tracking and PTE installation.
+        let map_daddr = match unsafe { prepare_dma_at(&paddr_range, exact_daddr) } {
+            Ok(daddr) => daddr,
+            Err(error) => {
+                let failure = match error {
+                    PrepareDmaAtError::RemappingUnavailable => {
+                        ExactDmaMapFailure::DmaRemappingUnavailable
+                    }
+                    PrepareDmaAtError::InvalidDaddr => ExactDmaMapFailure::InvalidDaddr,
+                    PrepareDmaAtError::DaddrUnavailable => ExactDmaMapFailure::DaddrUnavailable,
+                };
+                return Err(ExactDmaMapError { segment, failure });
+            }
+        };
+
+        Ok(Self {
+            inner: Inner::Segment(segment),
+            map_daddr: Some(map_daddr),
+            is_cache_coherent: true,
+            prepared: true,
+        })
+    }
+
